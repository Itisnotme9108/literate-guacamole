{
  "cleanUrls": true,
  "trailingSlash": false,
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/pages/shop.html", "destination": "/shop" },
    { "source": "/pages/collections.html", "destination": "/collections" },
    { "source": "/pages/bespoke.html", "destination": "/bespoke" },
    { "source": "/pages/product.html", "destination": "/product" }
  ]
}
